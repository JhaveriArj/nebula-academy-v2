{
  "name": "nebula-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn FTC robot programming in Java. Real Java, a virtual robot, no install.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/lint-design.mjs && node scripts/check-contrast.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "new-lesson": "node scripts/new-lesson.mjs",
    "verify:javac": "node scripts/verify-javac.mjs",
    "gen:coverage": "vite-node scripts/gen-coverage.ts",
    "gen:stubs": "vite-node scripts/gen-stubs.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
